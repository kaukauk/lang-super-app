# ── Secrets (NEVER commit) ──────────────────────────────────────────
chatgpt-api-key.txt
*api-key*.txt
gpt-api.txt
.env
.env.*
*.key

# ── Python ──────────────────────────────────────────────────────────
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Node / frontend ─────────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo

# ── App data (local SRS DB + cached transcripts) ────────────────────
backend/app.db
backend/app.db-*
data/
*.sqlite
*.sqlite3

# ── Downloaded videos + cut clips/audio + whisper/tts caches ─────────
.media_cache/

# ── Generated reports / scratch ─────────────────────────────────────
backend/sim_week_report.md
backend/realapi_result.txt

# ── The Anki fork (reference only; not part of the app, has its own git) ──
# Anchored with a leading slash: a bare `anki/` also matched backend/app/anki/,
# which silently kept the app's own AnkiConnect package out of every commit.
/anki/

# ── OS / editor ─────────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/

# verb-anchor clips: keep the script, ignore the media it produces
verb-clips/*
!verb-clips/make_clips.sh
